// Generated by tools/build_quest_giver_assets.py. UI text only: the native
// scene remains the sole owner of voice, lipsync and subtitle lifetime.
@addField(SubtitleLineLogicController)
private let ncpdVossSubtitleGeneration: Int32;

@addField(SubtitleLineLogicController)
private let ncpdVossSubtitleActive: Bool;

@wrapMethod(SubtitleLineLogicController)
public func SetLineData(const lineData: script_ref<scnDialogLineData>) -> Void {
    let data: scnDialogLineData;
    let speaker: ref<NPCPuppet>;
    let second: ref<NCPDPatrolVossSubtitleStep>;
    let third: ref<NCPDPatrolVossSubtitleStep>;
    this.ncpdVossSubtitleGeneration += 1;
    this.ncpdVossSubtitleActive = false;
    data = Deref(lineData);
    speaker = data.speaker as NPCPuppet;
    if !IsDefined(speaker) || !speaker.IsAttached()
        || speaker.GetRecordID() != t"Character.NCPDPatrol_QG_Investigator"
        || GameInstance.GetQuestsSystem(speaker.GetGame()).GetFactStr("ncpd_patrol_qgiver_test_stage") != 2
        || !Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_BriefingFull")) {
        wrappedMethod(lineData);
        return;
    };
    this.ncpdVossSubtitleActive = true;
    data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_BriefingPart1");
    wrappedMethod(data);
    second = new NCPDPatrolVossSubtitleStep();
    second.owner = this;
    second.generation = this.ncpdVossSubtitleGeneration;
    second.part = 2;
    GameInstance.GetDelaySystem(speaker.GetGame()).DelayCallback(second, 15.0, false);
    third = new NCPDPatrolVossSubtitleStep();
    third.owner = this;
    third.generation = this.ncpdVossSubtitleGeneration;
    third.part = 3;
    GameInstance.GetDelaySystem(speaker.GetGame()).DelayCallback(third, 28.5, false);
}

@addMethod(SubtitleLineLogicController)
public func NCPDVossAdvanceSubtitle(generation: Int32, part: Int32) -> Void {
    let speaker: ref<NPCPuppet>;
    if !this.ncpdVossSubtitleActive || generation != this.ncpdVossSubtitleGeneration { return; };
    speaker = this.m_lineData.speaker as NPCPuppet;
    if !IsDefined(speaker) || !speaker.IsAttached()
        || speaker.GetRecordID() != t"Character.NCPDPatrol_QG_Investigator"
        || GameInstance.GetQuestsSystem(speaker.GetGame()).GetFactStr("ncpd_patrol_qgiver_test_stage") != 2 { return; };
    if part == 2 {
        inkTextRef.SetText(this.m_targetTextWidgetRef, GetLocalizedTextByKey(n"NCPDPatrol_QG_BriefingPart2"));
    };
    if part == 3 {
        inkTextRef.SetText(this.m_targetTextWidgetRef, GetLocalizedTextByKey(n"NCPDPatrol_QG_BriefingPart3"));
    };
}

public class NCPDPatrolVossSubtitleStep extends DelayCallback {
    public let owner: wref<SubtitleLineLogicController>;
    public let generation: Int32;
    public let part: Int32;

    public func Call() -> Void {
        if IsDefined(this.owner) { this.owner.NCPDVossAdvanceSubtitle(this.generation, this.part); };
    }
}
