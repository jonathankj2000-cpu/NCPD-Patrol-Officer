// Generated by tools/build_quest_giver_assets.py. UI text only: the native
// scene owns each complete voice/lipsync event and its subtitle lifetime.
@addField(SubtitleLineLogicController)
private let ncpdVossSubtitleGeneration: Int32;

@addField(SubtitleLineLogicController)
private let ncpdVossSubtitleActive: Bool;

@wrapMethod(SubtitleLineLogicController)
public func SetLineData(const lineData: script_ref<scnDialogLineData>) -> Void {
    let data: scnDialogLineData;
    let speaker: ref<NPCPuppet>;
    let turn: Int32 = 0;
    this.ncpdVossSubtitleGeneration += 1;
    this.ncpdVossSubtitleActive = false;
    data = Deref(lineData);
    speaker = data.speaker as NPCPuppet;
    if !IsDefined(speaker) || !speaker.IsAttached()
        || speaker.GetRecordID() != t"Character.NCPDPatrol_QG_Investigator"
        || GameInstance.GetQuestsSystem(speaker.GetGame()).GetFactStr("ncpd_patrol_qgiver_test_stage") != 2 {
        wrappedMethod(lineData);
        return;
    };
    if Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss01_Full")) { turn = 1; };
    if Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss02_Full")) { turn = 2; };
    if Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss03_Full")) { turn = 3; };
    if Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss04_Full")) { turn = 4; };
    if Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss05_Full")) { turn = 5; };
    if Equals(data.text, GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss06_Full")) { turn = 6; };
    if turn == 0 { wrappedMethod(lineData); return; };
    this.ncpdVossSubtitleActive = true;
    if turn == 1 { data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss01_Part1"); };
    if turn == 2 { data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss02_Part1"); };
    if turn == 3 { data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss03_Part1"); };
    if turn == 4 { data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss04_Part1"); };
    if turn == 5 { data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss05_Part1"); };
    if turn == 6 { data.text = GetLocalizedTextByKey(n"NCPDPatrol_QG_Voss06_Part1"); };
    wrappedMethod(data);
    if turn == 1 {
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss01_Part2", 4.98);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss01_Part3", 9.54);
    };
    if turn == 2 {
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss02_Part2", 1.5);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss02_Part3", 5.46);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss02_Part4", 12.36);
    };
    if turn == 3 {
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss03_Part2", 4.04);
    };
    if turn == 4 {
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss04_Part2", 2.48);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss04_Part3", 8.2);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss04_Part4", 17.16);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss04_Part5", 19.14);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss04_Part6", 20.76);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss04_Part7", 23.86);
    };
    if turn == 5 {
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss05_Part2", 8.6);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss05_Part3", 15.32);
    };
    if turn == 6 {
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss06_Part2", 2.5);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss06_Part3", 6.18);
        this.NCPDVossQueueSubtitle(speaker, n"NCPDPatrol_QG_Voss06_Part4", 6.98);
    };
}

@addMethod(SubtitleLineLogicController)
private func NCPDVossQueueSubtitle(speaker: ref<NPCPuppet>, textKey: CName, seconds: Float) -> Void {
    let step: ref<NCPDPatrolVossSubtitleStep> = new NCPDPatrolVossSubtitleStep();
    step.owner = this;
    step.generation = this.ncpdVossSubtitleGeneration;
    step.textKey = textKey;
    GameInstance.GetDelaySystem(speaker.GetGame()).DelayCallback(step, seconds, false);
}

@addMethod(SubtitleLineLogicController)
public func NCPDVossAdvanceSubtitle(generation: Int32, textKey: CName) -> Void {
    let speaker: ref<NPCPuppet>;
    if !this.ncpdVossSubtitleActive || generation != this.ncpdVossSubtitleGeneration { return; };
    speaker = this.m_lineData.speaker as NPCPuppet;
    if !IsDefined(speaker) || !speaker.IsAttached()
        || speaker.GetRecordID() != t"Character.NCPDPatrol_QG_Investigator"
        || GameInstance.GetQuestsSystem(speaker.GetGame()).GetFactStr("ncpd_patrol_qgiver_test_stage") != 2 { return; };
    inkTextRef.SetText(this.m_targetTextWidgetRef, GetLocalizedTextByKey(textKey));
}

public class NCPDPatrolVossSubtitleStep extends DelayCallback {
    public let owner: wref<SubtitleLineLogicController>;
    public let generation: Int32;
    public let textKey: CName;

    public func Call() -> Void {
        if IsDefined(this.owner) { this.owner.NCPDVossAdvanceSubtitle(this.generation, this.textKey); };
    }
}
